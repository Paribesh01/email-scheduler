PORT=4000
NODE_ENV=development

# where the React app runs (used for CORS + post-login redirects)
FRONTEND_URL=http://localhost:5173
# public URL of this backend (used to build OAuth callback urls)
BACKEND_URL=http://localhost:4000

DATABASE_URL=postgresql://scheduler:scheduler@localhost:5433/email_scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# defaults to ${BACKEND_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Slack OAuth (https://api.slack.com/apps) - redirect must be https, use ngrok locally
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# defaults to ${BACKEND_URL}/api/slack/callback
SLACK_REDIRECT_URI=

# Worker / throughput
WORKER_CONCURRENCY=5
# minimum gap between two sends from the same sender
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
JOB_ATTEMPTS=3

# Ethereal senders. Either list existing accounts as user:pass,user:pass
# or leave empty and N test accounts are created on first boot (and saved in the db).
ETHEREAL_ACCOUNTS=
ETHEREAL_SENDER_COUNT=3

# process roles - run api and worker in one process or split them
RUN_API=true
RUN_WORKER=true

# optional basic auth for /admin/queues (user:pass). empty = open
BULL_BOARD_AUTH=
